{
  "name": "@dfh/host-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for DragonFableHelper",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "pnpm --filter @dfh/ui build && pnpm build",
    "start": "electron .",
    "dev": "concurrently -k \"pnpm --filter @dfh/ui dev\" \"pnpm build && cross-env DFH_DEV_SERVER=http://localhost:5273 electron .\"",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "typescript": "^5.6.3",
    "electron-builder": "^25.1.8"
  },
  "author": {
    "name": "DragonFableHelper contributors",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/Redu667/DragonFableHelper",
  "repository": {
    "type": "git",
    "url": "https://github.com/Redu667/DragonFableHelper.git"
  }
}
